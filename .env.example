# Lokal kjøring med Ollama. Ingen API-nøkkel trengs.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:8b
# Tom verdi bruker samme modell i et separat kontrollkall.
LLM_REVIEWER_MODEL=

NBIM_API_TIMEOUT=120
NBIM_MAX_OUTPUT_TOKENS=1500
NBIM_CONTEXT_TOKENS=16384
NBIM_MAX_API_CALLS=100
NBIM_MAX_INPUT_CHARACTERS=12000
NBIM_MAX_ATTEMPTS=5
NBIM_MIN_CONFIDENCE=0.8
NBIM_POLICY_PATH=policies/nbim_2025.json
NBIM_DATABASE_PATH=artifacts/audit.sqlite
# Endre ved bevisst revurdering, f.eks. etter oppdatering av en lokal modelltag.
NBIM_CACHE_NAMESPACE=default

# Valgfritt OpenAI-alternativ: bytt LLM_PROVIDER=openai og LLM_BASE_URL=https://api.openai.com/v1.
# Sett LLM_MODEL til en tilgjengelig OpenAI-modell og OPENAI_API_KEY lokalt.
OPENAI_API_KEY=
OPENAI_REASONING_EFFORT=
