{
  "name": "nbim-stemme-workspace",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src vite.config.ts index.html *.json",
    "format:check": "prettier --check src vite.config.ts index.html *.json"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
